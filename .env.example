# Public env vars must be prefixed with VITE_ to be exposed to the client.

# Base URL del backend Spring Boot.
# El script scripts/start-dev.ps1 no necesita editar este fichero: en modo tutor
# usa /api/v1 y el proxy de Vite hacia https://api.aura-ia.es.
# Para backend local manual, usar http://localhost:8080/api/v1.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Habilita banners y pantallas de debug en el panel (true | false)
VITE_DEV_MODE=true

# Idioma por defecto al cargar la app si el navegador no aporta uno soportado.
VITE_DEFAULT_LOCALE=es

# Cloudflare Turnstile site key (publico). Si se deja vacio, el captcha
# se omite en register y forgot-password (util en local). En produccion
# debe coincidir con TURNSTILE_SITE_KEY del backend.
VITE_TURNSTILE_SITE_KEY=
