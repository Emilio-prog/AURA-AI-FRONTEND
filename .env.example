# Public env vars must be prefixed with VITE_ to be exposed to the client.

# Base URL del backend Spring Boot. En Fase 1 (mocks autónomos) puede dejarse vacío.
# Ejemplo en producción: https://api.aura-ia.app
VITE_API_BASE_URL=http://127.0.0.1:8080/api/v1

# Habilita banners y pantallas de debug en el panel (true | false)
VITE_DEV_MODE=true

# Idioma por defecto al cargar la app si el navegador no aporta uno soportado.
VITE_DEFAULT_LOCALE=es

# Cloudflare Turnstile site key (público). Si se deja vacío, el captcha
# se omite en register y forgot-password (útil en local). En producción
# debe coincidir con TURNSTILE_SITE_KEY del backend.
VITE_TURNSTILE_SITE_KEY=
